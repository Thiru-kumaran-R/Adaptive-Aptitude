# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB (Development / Production) ───────────────────────────────────────
# Database: adaptive_aptitude
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adaptive_aptitude?appName=<appName>

# ─── MongoDB (Test) ───────────────────────────────────────────────────────────
# Separate database used exclusively by Jest tests. NEVER point at adaptive_aptitude.
# Database: adaptive_aptitude_test
TEST_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adaptive_aptitude_test?appName=<appName>

# ─── Environment ──────────────────────────────────────────────────────────────
# Values: development | test | production
NODE_ENV=development

# ─── Question Bank Source (for import scripts) ────────────────────────────────
# Absolute path to the verified question bank JSON directory.
# Defaults to ../../"Questions bank" relative to the project root if not set.
# QUESTIONS_BANK_PATH=/absolute/path/to/Questions bank

# ─── Phase 7: Intelligent Learning & LLM Layer ────────────────────────────────
LEARNING_LLM_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=
LEARNING_REQUIRE_ZERO_RETENTION=false
