{
  "name": "adaptive-aptitude-api",
  "version": "1.0.0",
  "description": "Adaptive Aptitude Learning Platform — Phase 1 (Foundation) + Phase 2 (Question Intelligence Layer)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --forceExit --coverage",
    "validate:questions": "node scripts/validateQuestions.js",
